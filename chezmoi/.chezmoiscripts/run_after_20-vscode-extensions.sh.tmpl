#!/bin/bash
# packages.vscode のうち未導入の拡張機能を入れる。apply のたびに実行するので、
# code がなかったときや失敗したときは次の apply でやり直す
set -uo pipefail
{{ template "brew-env.sh" . }}
if ! command -v code >/dev/null 2>&1; then
  echo "VS Code CLI (code) is missing; skipped extensions until the next apply." >&2
  exit 0
fi

extensions=(
{{- range .packages.vscode }}
  {{ . | quote }}
{{- end }}
)
# 拡張機能の ID は大文字と小文字を区別しない
installed="$(code --list-extensions | tr '[:upper:]' '[:lower:]')"
failed=0
for extension in "${extensions[@]}"; do
  lower="$(printf '%s' "$extension" | tr '[:upper:]' '[:lower:]')"
  grep -qxF "$lower" <<<"$installed" && continue
  code --install-extension "$extension" || failed=1
done
exit "$failed"

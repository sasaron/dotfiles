#!/bin/bash
# mac/Brewfile のうち未導入のものを入れる。starship や antidote などの依存を揃えるため、
# 設定ファイルより先に実行する。すべて導入済みなら brew bundle check だけで終わる
set -euo pipefail
{{ template "brew-env.sh" . }}
command -v brew >/dev/null 2>&1 || { echo "Homebrew is missing; run bootstrap.sh first." >&2; exit 1; }

brewfile={{ joinPath .chezmoi.workingTree "mac/Brewfile" | quote }}
export HOMEBREW_NO_AUTO_UPDATE=1
# chezmoi.toml の brewCaskSkip に挙げた cask は check でも install でも飛ばす。
# 実行時に HOMEBREW_BUNDLE_CASK_SKIP があればそちらを使う
export HOMEBREW_BUNDLE_CASK_SKIP="${HOMEBREW_BUNDLE_CASK_SKIP:-{{ .brewCaskSkip | default "" }}}"
# --no-upgrade がないと、古い版が入っているだけでも未充足と判定される
if ! brew bundle check --no-upgrade --file="$brewfile" >/dev/null 2>&1; then
  brew bundle install --no-upgrade --file="$brewfile"
fi

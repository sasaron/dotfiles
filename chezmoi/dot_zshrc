#!/bin/zsh

# Kiro CLI pre block. Keep at the top of this file.
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh"

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load
ZSH_THEME="robbyrussell"

# Uncomment the following line to disable auto-setting terminal title.
# Would you like to use another custom folder than $ZSH/custom?
export LANG=ja_JP.UTF-8

# 色を使用
autoload -Uz colors
colors

# Path settings
if [ -d "$HOME/bin" ]; then
    PATH=$PATH:$HOME/bin
fi

export PATH="$HOME/bin:$PATH"
export PATH="/usr/local/sbin:$PATH"
export PATH="/usr/local/opt/python@3.8/bin:$PATH"
export PATH="/usr/local/bin:$PATH"
export PATH="/opt/homebrew/bin:$PATH"
export PATH="/opt/homebrew/opt/gnu-getopt/bin:$PATH"

# History settings
HISTFILE=~/.zsh_history
HISTSIZE=5000
SAVEHIST=5000
export HISTTIMEFORMAT='%Y-%m-%dT%T%z '
export HISTCONTROL=erasedups
export HISTIGNORE=?:??:exit:history:ls*:pwd:cd*
setopt HIST_IGNORE_ALL_DUPS

# コマンドミスを修正
setopt correct

# 補完の選択を楽にする
zstyle ':completion:*' menu select

# 補完候補をできるだけ詰めて表示する
setopt list_packed

# Tab連打で補完候補を順に表示
setopt auto_menu

# TAB で順に補完候補を切り替える
setopt auto_param_keys

# 補完候補一覧でファイルの種別をマーク表示
setopt list_types

# Git settings from config/.zshrc
autoload -Uz vcs_info
setopt prompt_subst
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' unstagedstr "%F{red}+"
zstyle ':vcs_info:git:*' stagedstr "%F{yellow}!"
zstyle ':vcs_info:git*+set-message:*' hooks git-untracked
zstyle ':vcs_info:*' formats "[%F{magenta}%b%c%u%f]"
zstyle ':vcs_info:*' actionformats '[%b|%a]'

+vi-git-untracked(){
    if [[ $(git rev-parse --is-inside-work-tree 2> /dev/null) == 'true' ]] && \
        git status --porcelain | grep '??' &> /dev/null ; then
        hook_com[staged]+='%F{red}+'
    fi
}

# 色の設定
export LSCOLORS=Exfxcxdxbxegedabagacad

# 補完時の色設定
export LS_COLORS='di=01;34:ln=01;35:so=01;32:ex=01;31:bd=46;34:cd=43;34:su=41;30:sg=46;30:tw=42;30:ow=43;30'

# キャッシュの利用による補完の高速化
zstyle ':completion::complete:*' use-cache true

# 補完候補に色つける
autoload -U colors ; colors ; zstyle ':completion:*' list-colors "${LS_COLORS}"

# 大文字・小文字を区別しない(大文字を入力した場合は区別する)
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# manの補完をセクション番号別に表示させる
zstyle ':completion:*:manuals' separate-sections true

# Preferred editor for local and remote sessions
export EDITOR='vim'

# Golang settings
export GOPATH="$HOME"
# ~/bin は chezmoi が管理するコマンドの置き場なので、Go ツールは別の場所に入れる
export GOBIN="$HOME/.go/bin"
export PATH="$GOBIN:$GOPATH/bin:$PATH"

# vi キーバインド
bindkey -v
export KEYTIMEOUT=1

# insert mode では行編集のバインドを残す
bindkey -M viins '^A' beginning-of-line
bindkey -M viins '^E' end-of-line
bindkey -M viins '^K' kill-line
bindkey -M viins '^U' backward-kill-line
bindkey -M viins '^W' backward-kill-word
bindkey -M viins '^Y' yank
bindkey -M viins '^R' history-incremental-search-backward
bindkey -M viins '^?' backward-delete-char

# モードをカーソル形状で示す。starship init より前に置く。後ろに置くと
# starship が zle-keymap-select を差し替えてモード切替の再描画が止まる
function zle-keymap-select() {
    case "$KEYMAP" in
        vicmd) printf '\e[2 q' ;;
        *)     printf '\e[6 q' ;;
    esac
}
zle -N zle-keymap-select

function zle-line-init() {
    printf '\e[6 q'
}
zle -N zle-line-init

# Initialize starship prompt
eval "$(starship init zsh)"

# Modern command replacements
if command -v eza &> /dev/null; then
  alias ls="eza"
  alias ll="eza -la"
  alias lt="eza -T"
  alias la="eza -a"
else
  alias ll="ls -laG"
fi

if command -v bat &> /dev/null; then
  alias cat="bat"
fi

if command -v btm &> /dev/null; then
  alias top="btm"
fi

if command -v dust &> /dev/null; then
  alias du="dust"
fi

if command -v duf &> /dev/null; then
  alias df="duf"
fi

# Other aliases
alias dirs="dirs -v"
alias g='local repo=$(ghq list | fzf --preview "tree -C $(ghq root)/{} | head -100") && cd "$(ghq root)/$repo"'
# fzf-based interactive history search
# zle -N は関数しか呼べない。alias のままだと ^H が "No such shell function" になる
function h() {
    BUFFER=$(history -n 1 | sort -r | uniq | fzf)
    CURSOR=$#BUFFER
    zle reset-prompt
}
zle -N h
bindkey -M viins '^H' h
bindkey -M vicmd '^H' h
alias mysql="mysql --pager='less -S -n -i -F -X'"
alias ssm="aws ssm start-session --target"

# Functions
function hiscopy() {
    history | perl -anle 'print "@F[ 1..$#F ]"' | fzf | perl -ne 's/\n$//g;print' | pbcopy
}

# Add Homebrew's site-functions to fpath for completions like AWS CLI
if command -v brew &> /dev/null; then
  HOMEBREW_PREFIX=$(brew --prefix)
  if [ -d "$HOMEBREW_PREFIX/share/zsh/site-functions" ]; then
    fpath=($HOMEBREW_PREFIX/share/zsh/site-functions $fpath)
  fi
fi

# 補完機能を有効化。ダンプが24時間以内なら再生成と権限チェックを省く
_init_completion() {
  autoload -Uz compinit
  local fresh_dump=(~/.zcompdump(N.mh-24))
  if (( $#fresh_dump )); then
    compinit -C
  else
    compinit
    touch ~/.zcompdump
  fi
}

# プラグインは ~/.zsh_plugins.txt で管理する。
# _init_completion は .zsh_plugins.txt の post: から呼ばれる
antidote_home="${HOMEBREW_PREFIX:-/opt/homebrew}/opt/antidote/share/antidote"
if [[ -r "$antidote_home/antidote.zsh" ]]; then
  source "$antidote_home/antidote.zsh"
  antidote load ~/.zsh_plugins.txt
else
  echo "antidote not found: install it with 'brew install antidote'" >&2
  _init_completion
fi
unset antidote_home

# 履歴検索。ウィジェットはプラグイン読み込み後でないと存在しない
if zle -la | grep -q '^history-substring-search-up$'; then
    bindkey -M vicmd 'k' history-substring-search-up
    bindkey -M vicmd 'j' history-substring-search-down
    bindkey -M viins '^P' history-substring-search-up
    bindkey -M viins '^N' history-substring-search-down
fi

# Added by Windsurf
export PATH="$HOME/.codeium/windsurf/bin:$PATH"

alias claude="$HOME/.claude/local/claude"


# yazi。終了時のディレクトリにシェルも移動する
y() {
    local tmp cwd
    tmp="$(mktemp -t yazi-cwd.XXXXXX)"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
        builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

# Kiro CLI post block. Keep at the bottom of this file.
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh"

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"


# mise (Ruby version manager)
eval "$(mise activate zsh)"

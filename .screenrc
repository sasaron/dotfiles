# 起動時に自動でデタッチ
autodetach on
# バックグラウンドで出力されたベル文字をscreenに出力する
bell_msg "^G"
# Encoding
defkanji utf-8
defencoding utf-8
encoding utf-8 utf-8
# スクロールバックバッファの行数を設定
defscrollback 10000
# escape keyの設定
escape ^Tt
# 起動時に表示されるメッセージをoff
startup_message off
# 可視ベルの設定
vbell off
# 画面下部に表示されるcaptionの設定
caption always "%{=b .y}%H %{= .w}%-w%{=b .r}%n %t[選択中] %{-}%{= .w}%+w %= %{=b .c}[%l] %{=b .b}%y/%m/%d(%D) %{=b .m}%c"

# key bind
bind n screen
bind h prev
bind j next
# 全ウィンドウをリスト表示し、使用するウィンドウを選択できるようにする
bind l windowlist

# 256色対応 vim
attrcolor b ".I"
defbce on 
termcapinfo xterm* 'Co#256:AB=\E[48;5;%dm:AF=\E[38;5;%dm'

shelltitle console

{
  "components": [
    {
      "name": "apps",
      "source": "mac/Brewfile",
      "apply": [
        "bin/manage-apps.sh",
        "install"
      ]
    },
    {
      "name": "dotfiles",
      "source": "chezmoi/",
      "apply": [
        "bin/apply-chezmoi.sh"
      ]
    },
    {
      "name": "ai-skills",
      "source": "skills/",
      "apply": [
        "bin/install-ai-skills.sh"
      ]
    },
    {
      "name": "claude-mcp",
      "source": "config/ai/claude/mcp.json",
      "apply": [
        "bin/sync-claude-mcp.py",
        "--apply"
      ]
    }
  ]
}
